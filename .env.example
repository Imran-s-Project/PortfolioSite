# ── Public site ───────────────────────────────────────────────────────────────
# The site's domain is detected automatically (on Vercel: the project's production domain; locally: http://localhost:3000).
# Leave this commented out. Set it only to force one specific address, e.g. a custom domain: https://example.com
# NEXT_PUBLIC_SITE_URL=

# ── Firebase web app config (Firebase console → Project settings → Your apps) ──
# These identifiers are designed to be public; security comes from Security Rules + App Check.
# Still restrict the API key to your domains (Google Cloud console → Credentials → HTTP referrers).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── ImgBB image hosting (Admin Panel uploads) ──────────────────────────────────
# Free API key: sign in at https://api.imgbb.com/ and copy it. SERVER-ONLY — no NEXT_PUBLIC_ prefix, so it is never part of the
# JavaScript visitors download. Signed-in administrators receive it from /api/imgbb-key; nobody else can.
# On Vercel: Project → Settings → Environment Variables (Production and Preview), then redeploy.
IMGBB_API_KEY=

# ── App Check (reCAPTCHA v3 site key from Firebase console → App Check) ────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Local development only: paste the debug token printed in the browser console and register it in App Check.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# ── Optional switches ──────────────────────────────────────────────────────────
# Firebase Analytics (GA4). Off by default; turn on only after updating the privacy page to match.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
# Point the browser SDK at the local Firebase Emulator Suite.
NEXT_PUBLIC_USE_EMULATORS=false
